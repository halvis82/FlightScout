# Postgres. Neon on Vercel, local Docker in dev, or "pglite:./.pglite" for a serverless-free local DB.
DATABASE_URL=pglite:./.pglite

# Better Auth
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
BETTER_AUTH_URL=http://localhost:3000
# production: https://flightscout-app.vercel.app

# Only these emails can create accounts (comma separated). Everyone else can use guest mode.
ALLOWED_SIGNUP_EMAILS=you@example.com

# Optional OAuth (buttons appear only when both values are set)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Python engine (engine/ FastAPI app)
ENGINE_URL=http://127.0.0.1:8787
# production: https://flightscout-engine.vercel.app
ENGINE_KEY=dev-engine-key

# Shared secret the GitHub Actions tracker sends as x-tracker-key
TRACKER_KEY=dev-tracker-key

# Web push (generate with: npx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Email alerts through Resend (optional)
RESEND_API_KEY=
ALERT_FROM_EMAIL="FlightScout <alerts@example.com>"

# Protects /api/cron/* (Vercel sends it automatically as a Bearer token)
CRON_SECRET=
